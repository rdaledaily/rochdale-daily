# Baseline browser hardening for every response. These four are safe to apply
# site-wide: they do not restrict scripts, fonts or images (that is a CSP job,
# to be introduced deliberately once inline scripts are inventoried). They stop
# MIME sniffing, clickjacking in third-party frames, and referrer leakage of
# reader URLs to other sites.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/articles/frontpage.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/articles.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/scraper_status.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/weather.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/adverts.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/feel-good-live.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Written by the GMP watcher and read at request time by the Pages Functions.
# A cached copy here would spend the minute the watcher exists to save.
/breaking.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/story_blocklist.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Editorial images are static files and dominate article transfer size. A one-day
# browser TTL materially improves repeat visits while still allowing same-name
# corrections to propagate quickly; stale-while-revalidate keeps navigation fast.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# CSS is shared by many pages. Keep a modest TTL because filenames are not yet
# content-hashed, so design changes still reach readers promptly.
/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Advertising behaviour can change independently of editorial deployments, so
# keep the ad loader uncached. The remaining shared site JavaScript is versioned
# through normal deployments and benefits repeat readers when moving between
# several articles in one session.
/assets/ads.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/assets/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/articles/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
